     Serial.println(i);
 
     for (size_t j = 0; j < 8; ++j) {
       size_t addr = i * sector_size + j * chunk_size;
       size_t remaining = flash_image_size > addr ? flash_image_size - addr : 0;
       size_t write_len = remaining > chunk_size ? chunk_size : remaining;
 
       if (write_len == 0) break;
 
       memset(chunk, 0xFF, chunk_size);
       memcpy(chunk, &flash_image[addr], write_len);
 
       isd.flashWrite(addr, chunk, chunk_size);
     }
   }
 
   Serial.println("Verifying...");
 
   // Verify flash
   bool ok = true;
   for (size_t addr = 0; addr < flash_image_size; addr += chunk_size) {
     size_t verify_len = (flash_image_size - addr) > chunk_size ? chunk_size : (flash_image_size - addr);
     isd.flashRead(addr, chunk, chunk_size);
     if (memcmp(chunk, &flash_image[addr], verify_len) != 0) {
       Serial.print("Verify failed at address ");
       Serial.println(addr, HEX);
       ok = false;
       break;
     }
   }
 
   if (ok) {
    Serial.println("Flash verify OK!");

    Serial.println("Playing 'test' prompt...");
    isd.playVoicePrompt(3); 
    delay(3000); // Wait for playback (adjust as needed)
  } else {
    Serial.println("Flash verify FAILED!");
    digitalWrite(VIBRATOR_PIN, HIGH); // Vibrator ON to indicate error
  }
 
   isd.powerDown();
 }
 
 void loop()
 {
 }